# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/

# ---- 虚拟环境（体积大，不入库）----
.venv/
env/

# ---- 数据：只保留占位文件 ----
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# ---- 运行产物 ----
outputs/figures/*
outputs/tables/*
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep
logs/*.log

# ---- 编辑器与系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
